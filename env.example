# ---------------------------------------------------------------------------
# SOL-PERP Evolutionary Trading System — example environment file
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# The system defaults to PAPER mode; live trading requires explicit opt-in.
# ---------------------------------------------------------------------------

# --- Execution mode ---------------------------------------------------------
# "paper" (default, no real orders) or "live" (routes real orders — use with care)
TRADING_MODE=paper

# --- Coinbase CDP / Advanced Trade credentials ------------------------------
# Obtain from the Coinbase Developer Platform. Only required for live mode
# and/or fetching real historical data via core/data.py:fetch_coinbase().
# VERIFY exact key names/format vs the cdp-sdk you install.
CDP_API_KEY_NAME=
CDP_API_KEY_PRIVATE_KEY=

# --- UI server --------------------------------------------------------------
UI_HOST=127.0.0.1
UI_PORT=8000

# --- Compute ----------------------------------------------------------------
# "auto" uses CuPy if a CUDA GPU is present, else NumPy. Force with "cpu"/"gpu".
COMPUTE_BACKEND=auto

# --- Determinism ------------------------------------------------------------
GLOBAL_SEED=42
